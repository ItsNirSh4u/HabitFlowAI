  "description": "HabitFlow AI Unified Backend - Complete API with Authentication, AI Integration, and Persona Management",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
