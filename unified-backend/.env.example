# HabitFlow Unified Backend - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MongoDB)
# Required for authentication and user data persistence
# Example: mongodb://localhost:27017/habitflow
# Or MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/habitflow
MONGO_URI=

# Security
# Required for JWT token generation and validation
# Generate a secure random string (e.g., openssl rand -base64 32)
JWT_SECRET=

# AI Integration - OpenAI (Optional)
# Used for generating personalized motivation messages
# Get your API key from: https://platform.openai.com/api-keys
# If not provided, the system will use mock responses
OPENAI_API_KEY=

# AI Integration - Google Gemini (Optional)
# Used for advanced persona classification
# Get your API key from: https://makersuite.google.com/app/apikey
# If not provided, the /api/classify endpoint will return an error
GEMINI_API_KEY=
